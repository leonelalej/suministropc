---
import '../styles/global.css';
import { assetPath } from '../lib/assets';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mi PC Suministro — Catálogo de Hardware y Suministros',
  description =
    'Catálogo técnico de componentes y suministros de PC en Maracaibo. Precios en USD con referencia en Bs., cotización instantánea por WhatsApp. Envíos y retiro.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://leonelalej.github.io');
const ogImage = new URL(assetPath('logo.png'), canonical);
---

<!doctype html>
<html lang="es" class="min-h-[100dvh]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
    <link rel="apple-touch-icon" href={assetPath('logo.png')} />
    <title>{title}</title>
  </head>
  <body class="min-h-[100dvh] bg-zinc-950 font-sans text-zinc-100 antialiased selection:bg-accent/20 selection:text-cyan-100">
    <slot />
  </body>
</html>
